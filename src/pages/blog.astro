---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import PageHero from "@/components/sections/PageHero.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { breadcrumbs } from "@/data/schema";
import { posts, hasPosts, fmtDate, postTeaser } from "@/data/blog";
import { siteUrl } from "@/data/site";

const title = "Foot and Ankle Health Blog | Run Doctor Kirkland";
const description =
  "Tips from Kirkland podiatrists on heel pain, plantar fasciitis, ingrown toenails, bunions, running injuries and kids' foot care.";
const featured = posts.slice(0, 6);
const rest = posts.slice(6);
const jsonLd = [
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog" }]),
  {
    "@type": "CollectionPage",
    "@id": `${siteUrl}/blog#page`,
    url: new URL("/blog", siteUrl).href,
    name: title,
    description,
    isPartOf: { "@id": `${siteUrl}/#website` },
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={!hasPosts}>
  <Header />
  <main id="main">
    <PageHero
      crumb="Blog"
      eyebrow="From the Blog"
      title="Tips to keep you on your feet."
      intro="Plain answers from our Kirkland podiatrists on foot and ankle pain, running injuries and kids' foot care."
    />
    <section class="section bg-cream">
      <div class="container-x">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {featured.map((p) => (
            <article class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-xl shadow-navy-900/5">
              {p.image && (
                <div class="aspect-[4/3] overflow-hidden bg-navy-100">
                  <img src={p.image} alt="" width="800" height="600" loading="lazy" decoding="async" class="size-full object-cover transition duration-700 group-hover:scale-105" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-7">
                <p class="text-xs font-semibold tracking-[0.2em] text-ember-600 uppercase">{p.category ?? "Foot Care"}</p>
                <h2 class="mt-3 text-2xl leading-snug">
                  <a href={`/blog/${p.slug}`} class="after:absolute after:inset-0">{p.title}</a>
                </h2>
                <p class="mt-3 line-clamp-4 text-muted">{postTeaser(p)}</p>
                {p.date && <p class="mt-auto pt-5 text-sm text-muted">{fmtDate(p.date)}</p>}
              </div>
            </article>
          ))}
        </div>

        {rest.length > 0 && (
          <div class="mt-16">
            <h2 class="text-3xl">More articles</h2>
            <ul class="mt-6 divide-y divide-navy-900/10 border-y border-navy-900/10">
              {rest.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}`} class="flex flex-col gap-1 py-4 hover:text-ember-600 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <span class="font-semibold">{p.title}</span>
                    {p.date && <span class="shrink-0 text-sm text-muted">{fmtDate(p.date)}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {!hasPosts && <p class="text-lg text-muted">Articles are coming soon.</p>}
      </div>
    </section>
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>
