---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  light?: boolean;
}
const { eyebrow, title, intro, align = "left", light = false } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <p
    class:list={[
      "eyebrow",
      light && "text-ember-400!",
      align === "center" && "justify-center",
    ]}
  >
    {eyebrow}
  </p>
  <h2 class:list={["h-section", light && "text-white!"]} set:html={title} />
  {intro && (
    <p class:list={["mt-5 text-lg", light ? "text-white/75" : "text-muted"]}>
      {intro}
    </p>
  )}
</div>
