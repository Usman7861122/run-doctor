---
/**
 * <img> with lazy loading, fixed aspect (no layout shift) and a safe fallback
 * to /images/placeholder.svg if the remote image fails.
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}
const {
  src,
  alt,
  class: cls = "",
  width = 800,
  height = 600,
  eager = false,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={eager ? "high" : "auto"}
  class={cls}
  onerror="this.onerror=null;this.src='/images/placeholder.svg'"
/>
