---
import Icon from "@/components/ui/Icon.astro";
import HeroText from "@/components/react/HeroText";
import { practice } from "@/data/site";
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-navy-950 pt-28 pb-16 sm:items-center sm:pb-24"
>
  <!-- Background video (muted autoplay loop). Poster shows instantly while it loads. -->
  <video
    id="hero-video"
    class="absolute inset-0 -z-20 size-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/videos/hero-poster.webp"
    aria-hidden="true"
  >
    <source src="/videos/hero-mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
    <source src="/videos/hero.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950/90 via-navy-950/60 to-navy-950/10"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-navy-950/70 to-transparent"></div>

  <div class="container-x">
    <HeroText client:load />
    <a
      href="#pediatrics"
      class="group mt-8 inline-flex min-h-11 items-center gap-3 rounded-full border border-white/20 bg-white/10 py-2 pr-5 pl-2 text-sm font-medium text-white backdrop-blur-md transition hover:bg-white/20"
    >
      <span class="rounded-full bg-ember-500 px-3 py-1 text-xs font-bold tracking-wider uppercase">
        Kids
      </span>
      Foot and ankle care for children and teens
      <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>

  <!-- Round logo: ring turns and mark floats as you scroll (desktop) -->
  <div
    id="hero-badge"
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 right-[6%] hidden aspect-square w-[min(34vw,30rem)] -translate-y-[45%] lg:block xl:right-[9%]"
  >
    <img id="hero-ring" src="/logos/rundoctor-ring-white.svg" alt="" width="1000" height="1000" class="absolute inset-0 size-full will-change-transform drop-shadow-[0_4px_24px_rgba(0,0,0,0.45)]" />
    <img id="hero-mark" src="/logos/rundoctor-mark-orange.png" alt="" width="900" height="900" class="absolute top-[26.2%] left-[27.2%] w-[45.6%] will-change-transform drop-shadow-[0_4px_18px_rgba(0,0,0,0.4)]" />
  </div>

  <!-- Rating badge -->
  <div class="absolute right-8 bottom-10 hidden items-center gap-4 rounded-2xl border border-white/15 bg-white/10 px-5 py-4 text-white backdrop-blur-md lg:flex">
    <div class="flex text-ember-400">
      {Array.from({ length: 5 }).map(() => (
        <Icon name="star" class="size-4 fill-current" />
      ))}
    </div>
    <div class="text-sm leading-tight">
      <span class="font-semibold">{practice.rating.score} / 5</span>
      <span class="block text-white/70">
        {practice.rating.count} patient reviews
      </span>
    </div>
  </div>
</section>

<script>
  // Respect "reduce motion": stop the video and keep the still poster.
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.removeAttribute("autoplay");
    video.pause();
  }
  // Scroll motion: the ring turns, the mark drifts and the badge fades out.
  const badge = document.getElementById("hero-badge");
  const ring = document.getElementById("hero-ring");
  const mark = document.getElementById("hero-mark");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (badge && ring && mark && !still) {
    let ticking = false;
    const update = () => {
      const y = Math.min(window.scrollY, window.innerHeight * 1.2);
      ring.style.transform = `rotate(${y * 0.22}deg)`;
      mark.style.transform = `translateY(${y * -0.06}px) rotate(${y * -0.03}deg) scale(${1 + y * 0.0003})`;
      badge.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.9)));
      ticking = false;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
