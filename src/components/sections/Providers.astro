---
import Watermark from "@/components/ui/Watermark.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import FadeIn from "@/components/react/FadeIn";
import { physicians } from "@/data/site";
---

<section id="providers" class="section bg-navy-50">
  <div class="container-x">
    <SectionHeading
      align="center"
      eyebrow="Choose Your Provider"
      title="Two physicians. One shared goal."
      intro="Pick the doctor you'd like to see, or let us match you with the best fit for your needs."
    />

    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      {physicians.map((d, i) => (
        <FadeIn client:visible delay={i * 0.1}>
          <article class="group grid h-full overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-navy-900/5 sm:grid-cols-5">
            <!-- Portrait panel: circular photo on navy, with brand ring and runner watermark -->
            <div class="relative grid min-h-72 place-items-center overflow-hidden bg-gradient-to-br from-navy-800 to-navy-950 p-6 sm:col-span-2">
              <Watermark class="-right-10 -bottom-10 h-64 bg-white/[0.06]" />
              <div class="relative">
                <span aria-hidden="true" class="absolute -inset-3 rounded-full border border-ember-500/50 transition-transform duration-700 ease-(--ease-elegant) group-hover:scale-105"></span>
                <img
                  src={d.img}
                  alt={`Portrait of ${d.name}`}
                  width="720"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="relative aspect-square size-44 max-w-none shrink-0 rounded-full object-cover ring-4 ring-white/10 transition duration-700 ease-(--ease-elegant) group-hover:scale-[1.03] lg:size-32 xl:size-40"
                />
              </div>
            </div>
            <div class="flex flex-col p-8 sm:col-span-3 sm:p-10">
              <p class="text-xs font-semibold tracking-[0.2em] text-ember-600 uppercase">
                {d.title}
              </p>
              <h3 class="mt-3 text-3xl sm:text-4xl">{d.name}</h3>
              <p class="mt-4 text-muted">{d.bio}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {d.tags.map((t) => (
                  <li class="rounded-full bg-navy-50 px-3 py-1.5 text-xs font-medium text-navy-800">
                    {t}
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex flex-wrap gap-3 pt-8">
                <a href="#contact" class="btn-primary">
                  <Icon name="calendar" class="size-4" />
                  Book with Dr. {d.name.split(" ")[1].replace(",", "")}
                </a>
                <a href="#" class="btn-outline">
                  Full Bio
                </a>
              </div>
            </div>
          </article>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
