---
import Img from "@/components/ui/Img.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import FadeIn from "@/components/react/FadeIn";
import type { FlipItem } from "@/data/site";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: FlipItem[];
  viewMoreLabel: string;
  viewMoreHref: string;
  tone?: "light" | "tint";
}
const {
  id,
  eyebrow,
  title,
  intro,
  items,
  viewMoreLabel,
  viewMoreHref,
  tone = "light",
} = Astro.props;
---

<section
  id={id}
  class:list={["section", tone === "tint" ? "bg-navy-50" : "bg-sand-50"]}
>
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
      <a
        href={viewMoreHref}
        class="btn-outline shrink-0 self-start md:self-auto"
      >
        {viewMoreLabel}
        <Icon name="arrow" class="size-4" />
      </a>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <li>
          <FadeIn client:visible delay={i * 0.08}>
            <div class="flip h-[26rem]" data-flip>
              <div class="flip-inner relative size-full">
                {/* Front */}
                <div class="flip-face absolute inset-0 overflow-hidden rounded-3xl bg-navy-800 shadow-lg shadow-navy-900/10">
                  <Img
                    src={item.img}
                    alt=""
                    width={700}
                    height={900}
                    class="size-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy-950/95 via-navy-950/25 to-transparent" />
                  <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-7">
                    <h3 class="text-3xl leading-tight text-white!">
                      {item.title}
                    </h3>
                    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ember-500 text-navy-950">
                      <Icon name="arrow" class="size-5 -rotate-45" />
                    </span>
                  </div>
                </div>
                {/* Back */}
                <div class="flip-face flip-back absolute inset-0 flex flex-col rounded-3xl bg-navy-900 p-8 text-white shadow-xl">
                  <span class="grid size-12 place-items-center rounded-2xl bg-ember-500/15 text-ember-400">
                    <Icon name="activity" class="size-6" />
                  </span>
                  <h3 class="mt-6 text-3xl text-white!">{item.title}</h3>
                  <p class="mt-4 text-white/75">{item.excerpt}</p>
                  <a href={item.href} class="btn-primary mt-auto self-start">
                    Read More <span class="sr-only">about {item.title}</span>
                    <Icon name="arrow" class="size-4" />
                  </a>
                </div>
              </div>
            </div>
          </FadeIn>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-center text-sm text-muted lg:hidden">
      Tap a card to learn more.
    </p>
  </div>
</section>

<script>
  // Touch devices have no hover, so a tap flips the card.
  document.querySelectorAll<HTMLElement>("[data-flip]").forEach((card) => {
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      if (window.matchMedia("(hover: hover)").matches) return;
      card.classList.toggle("is-flipped");
    });
  });
</script>
