---
import Img from "@/components/ui/Img.astro";
import FadeIn from "@/components/react/FadeIn";
import { images, maurerWork } from "@/data/site";
---

<section id="maurer-work" class="section relative overflow-hidden bg-sand-100">
  <!-- Large decorative word -->
  <p
    aria-hidden="true"
    class="pointer-events-none absolute -top-6 right-0 font-serif text-[12rem] leading-none text-navy-900/[0.04] italic select-none sm:text-[18rem]"
  >
    Beyond
  </p>

  <div class="container-x relative grid items-center gap-14 lg:grid-cols-12">
    <FadeIn client:visible className="lg:col-span-5">
      <p class="eyebrow">More of Dr. Maurer's Work</p>
      <h2 class="h-section">
        A surgeon's eye, <br />
        <em class="text-ember-600">on and off</em> the field.
      </h2>
      <p class="mt-6 text-lg text-muted">
        Beyond the clinic, Dr. Maurer is a sports photographer, teacher and
        lifelong athlete. He is also a classically trained pianist and vocalist.
        That same eye for detail and movement shapes the way he cares for every
        patient.
      </p>

      <ol class="mt-10 divide-y divide-navy-900/10 border-y border-navy-900/10">
        {maurerWork.map((w, i) => (
          <li class="group flex gap-6 py-5">
            <span class="font-serif text-lg text-ember-600">0{i + 1}</span>
            <span>
              <span class="block font-serif text-2xl text-navy-900 transition-colors group-hover:text-ember-600">
                {w.label}
              </span>
              <span class="mt-1 block text-muted">{w.text}</span>
            </span>
          </li>
        ))}
      </ol>
    </FadeIn>

    <FadeIn client:visible delay={0.15} className="lg:col-span-7">
      <figure class="relative">
        <div class="aspect-[4/3] overflow-hidden rounded-[2rem] bg-navy-100 shadow-2xl shadow-navy-900/20">
          <Img
            src={images.maurerWork}
            alt="Stadium under the lights during a professional match"
            width={1400}
            height={1050}
            class="size-full object-cover"
          />
        </div>
        <figcaption class="absolute -bottom-8 left-6 max-w-xs rounded-2xl bg-navy-900 p-6 text-white shadow-xl sm:left-10">
          <p class="text-xs tracking-widest text-ember-400 uppercase">
            On the sideline
          </p>
          <p class="mt-2 font-serif text-xl leading-snug">
            Team photographer for the Seattle Seahawks and Sounders.
          </p>
        </figcaption>
      </figure>
    </FadeIn>
  </div>
</section>
