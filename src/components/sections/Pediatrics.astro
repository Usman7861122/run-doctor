---
import Img from "@/components/ui/Img.astro";
import Icon from "@/components/ui/Icon.astro";
import FadeIn from "@/components/react/FadeIn";
import { pediatrics as p, practice } from "@/data/site";
---

<section
  id="pediatrics"
  class="section relative overflow-clip bg-ember-50 pb-10! sm:pb-14!"
>
  <!-- Soft playful shapes -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-ember-200/50 blur-2xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -left-20 size-96 rounded-full bg-navy-100/70 blur-2xl"
  >
  </div>

  <div class="container-x relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      <!-- Text -->
      <FadeIn client:visible>
        <p class="eyebrow">{p.eyebrow}</p>
        <h2 class="h-section">
          Little feet. <em class="text-ember-600">Big adventures.</em>
        </h2>
        <p class="mt-6 max-w-xl text-lg text-muted">{p.intro}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/#contact" class="btn btn-primary">
            Book a Kids Visit
            <Icon name="arrow" class="size-4" />
          </a>
          <a href={practice.phoneHref} class="btn btn-outline">
            Call {practice.phone}
          </a>
        </div>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            p.cards.map((c, i) => (
              <li class="group rounded-3xl bg-white p-6 shadow-sm ring-1 ring-navy-900/5 transition duration-500 hover:-translate-y-1 hover:shadow-xl">
                <span class="grid size-10 place-items-center rounded-full bg-ember-500 font-serif text-lg text-white transition-transform duration-500 group-hover:rotate-12">
                  {i + 1}
                </span>
                <h3 class="mt-4 font-serif text-2xl text-navy-900">{c.title}</h3>
                <p class="mt-2 text-[0.95rem] text-muted">{c.text}</p>
              </li>
            ))
          }
        </ul>
      </FadeIn>

      <!-- Photos + checklist -->
      <FadeIn client:visible delay={0.1}>
        <div class="grid grid-cols-5 gap-4">
          <div
            class="relative col-span-3 row-span-2 overflow-hidden rounded-[2rem] bg-navy-100"
          >
            <Img
              src={p.images.main}
              alt="A boy running across a grassy field"
              width={900}
              height={1100}
              class="size-full min-h-80 object-cover"
            />
          </div>
          <div
            class="col-span-2 aspect-square overflow-hidden rounded-[2rem] bg-navy-100"
          >
            <Img
              src={p.images.top}
              alt="Two happy children running hand in hand"
              width={500}
              height={500}
              class="size-full object-cover"
            />
          </div>
          <div
            class="col-span-2 aspect-square overflow-hidden rounded-[2rem] bg-navy-100"
          >
            <Img
              src={p.images.bottom}
              alt="Children running across a grass field"
              width={500}
              height={500}
              class="size-full object-cover"
            />
          </div>
        </div>

        <div class="mt-5 rounded-[2rem] bg-navy-900 p-7 text-white sm:p-9">
          <h3 class="font-serif text-2xl text-white! sm:text-3xl">{p.signsTitle}</h3>
          <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {
              p.signs.map((s) => (
                <li class="flex items-start gap-3 text-[0.95rem] text-white/85">
                  <Icon
                    name="check"
                    class="mt-0.5 size-5 shrink-0 text-ember-400"
                  />
                  {s}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 border-t border-white/10 pt-5 text-sm text-white/60">
            {p.note}
          </p>
        </div>
      </FadeIn>
    </div>
  </div>
</section>
