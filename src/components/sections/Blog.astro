---
import Img from "@/components/ui/Img.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import FadeIn from "@/components/react/FadeIn";
import { blog } from "@/data/site";
---

<section id="blog" class="section bg-white">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <SectionHeading
        eyebrow="From the Blog"
        title="Tips to keep you on your feet."
      />
      <a href="#" class="btn-outline shrink-0 self-start md:self-auto">
        All Articles
        <Icon name="arrow" class="size-4" />
      </a>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {blog.map((b, i) => (
        <FadeIn client:visible delay={i * 0.08}>
          <article class="group relative flex h-full flex-col">
            <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-navy-100">
              <Img
                src={b.img}
                alt=""
                width={800}
                height={600}
                class="size-full object-cover transition duration-700 ease-(--ease-elegant) group-hover:scale-105"
              />
            </div>
            <p class="mt-6 text-xs font-semibold tracking-[0.2em] text-ember-600 uppercase">
              {b.category}
            </p>
            <h3 class="mt-3 text-2xl leading-snug">
              <a
                href={b.href}
                class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 group-hover:bg-[length:100%_1px] after:absolute after:inset-0"
              >
                {b.title}
              </a>
            </h3>
            <p class="mt-3 text-muted">{b.excerpt}</p>
            <span class="link-arrow mt-5">
              Read article{" "}
              <Icon
                name="arrow"
                class="size-4 transition-transform group-hover:translate-x-1"
              />
            </span>
          </article>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
