---
import Icon from "@/components/ui/Icon.astro";
import { menu } from "@/data/menu";
import { practice } from "@/data/site";

const chevron =
  '<svg viewBox="0 0 24 24" class="chev size-3.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
const ext = (external?: boolean) =>
  external ? { target: "_blank", rel: "noopener" } : {};
---

<header
  id="site-header"
  class="group/header fixed inset-x-0 top-0 z-50"
  data-solid="false"
>
  <!-- Background layer (kept separate so the blur doesn't trap fixed children) -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-20 bg-sand-50/95 opacity-0 shadow-[0_1px_0_rgba(13,39,66,0.08)] backdrop-blur-lg transition-opacity duration-500 group-data-[solid=true]/header:opacity-100"
  ></div>
  <div class="container-x relative flex h-20 items-center justify-between gap-6">
    <!-- Logo: one transparent amber logo that works on dark and light headers -->
    <a
      href="/"
      class="relative block h-11 w-[172px] shrink-0 sm:h-12 sm:w-[187px]"
      aria-label={`${practice.shortName}, ${practice.name}, home`}
    >
      <img
        src="/logos/rundoctor-logo-amber.png"
        alt=""
        width="1600"
        height="411"
        class="size-full object-contain object-left"
      />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {menu.map((item, i) =>
          item.kind === "link" ? (
            <li>
              <a href={item.href} class="nav-trigger">
                {item.label}
              </a>
            </li>
          ) : (
            <li
              class:list={["menu-item", item.kind === "drop" && "relative"]}
              data-menu-item
              data-open="false"
            >
              <button
                type="button"
                class="nav-trigger"
                aria-expanded="false"
                aria-controls={`panel-${i}`}
                data-menu-trigger
              >
                {item.label}
                <Fragment set:html={chevron} />
              </button>

              <div
                  id={`panel-${i}`}
                  class="menu-panel drop absolute top-full left-1/2 pt-4"
                  data-menu-panel
                >
                  <div
                    class:list={[
                      "flex rounded-3xl bg-white shadow-2xl shadow-navy-950/20 ring-1 ring-navy-900/5",
                      !item.groups && "overflow-hidden",
                      item.aside ? "w-[36rem]" : item.groups ? "w-64" : "w-80",
                    ]}
                  >
                    {item.groups ? (
                      <div class="flex-1 p-3">
                        <ul>
                          {item.groups.map((g) => (
                            <li class="cat relative">
                              <button
                                type="button"
                                class:list={["cat-row", g.featured && "cat-featured"]}
                                aria-haspopup="true"
                              >
                                <span class="flex items-center gap-2">
                                  {g.title}
                                  {g.featured && (
                                    <span class="rounded-full bg-ember-500 px-2 py-0.5 text-[0.6rem] font-bold tracking-wider text-white uppercase">
                                      Featured
                                    </span>
                                  )}
                                </span>
                                <Icon name="arrow" class="size-4" />
                              </button>
                              <div class="cat-sub absolute top-0 left-full pl-3">
                                <ul class="w-64 rounded-2xl bg-white p-2 shadow-2xl shadow-navy-950/20 ring-1 ring-navy-900/5">
                                  {g.links.map((l) => (
                                    <li>
                                      <a href={l.href} class="drop-link-sm">
                                        {l.label}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            </li>
                          ))}
                        </ul>
                        {item.footer && (
                          <a
                            href={item.footer.href}
                            class="group/foot mt-2 flex min-h-11 items-center justify-between rounded-xl border-t border-navy-900/5 px-4 pt-2 text-sm font-semibold text-navy-900 hover:text-ember-600"
                          >
                            {item.footer.label}
                            <Icon
                              name="arrow"
                              class="size-4 text-ember-600 transition-transform group-hover/foot:translate-x-1"
                            />
                          </a>
                        )}
                      </div>
                    ) : (
                    <ul class="flex-1 p-3">
                      {item.links.map((l) => (
                        <li>
                          <a
                            href={l.href}
                            class="drop-link group/drop"
                            {...ext(l.external)}
                          >
                            <span class="flex items-center gap-2 font-semibold text-navy-900">
                              {l.label}
                              {l.external && (
                                <span class="sr-only">
                                  (opens in a new tab)
                                </span>
                              )}
                              <Icon
                                name="arrow"
                                class="size-3.5 -translate-x-1 text-ember-600 opacity-0 transition duration-300 group-hover/drop:translate-x-0 group-hover/drop:opacity-100"
                              />
                            </span>
                            {l.note && (
                              <span class="mt-0.5 block text-sm text-muted">
                                {l.note}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                    )}
                    {item.aside && (
                      <div class="flex w-52 flex-col justify-between bg-navy-900 p-6 text-white">
                        <div>
                          <p class="font-serif text-2xl">{item.aside.title}</p>
                          <p class="mt-2 text-sm text-white/70">
                            {item.aside.text}
                          </p>
                        </div>
                        <a
                          href={item.aside.cta.href}
                          class="btn-primary mt-6 min-h-11 px-5"
                        >
                          {item.aside.cta.label}
                        </a>
                      </div>
                    )}
                  </div>
                </div>
            </li>
          ),
        )}
      </ul>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <a
        href={practice.phoneHref}
        class="hidden items-center gap-2 text-sm font-semibold text-white transition-colors group-data-[solid=true]/header:text-navy-900 xl:flex"
      >
        <Icon name="phone" class="size-4 text-ember-400" />
        {practice.phone}
      </a>
      <a href="/#contact" class="btn-primary hidden sm:inline-flex">
        Book Now
      </a>
      <button
        id="menu-open"
        type="button"
        class="grid size-12 place-items-center rounded-full text-white group-data-[solid=true]/header:text-navy-900 lg:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <!-- ================= Mobile menu ================= -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-50 flex flex-col bg-navy-950 opacity-0 transition-all duration-500 data-[open=true]:visible data-[open=true]:opacity-100 lg:hidden"
    data-open="false"
  >
    <div class="container-x flex h-20 shrink-0 items-center justify-between">
      <img
        src="/logos/rundoctor-logo-amber.png"
        alt="Run Doctor"
        width="1600"
        height="411"
        class="h-11 w-auto"
      />
      <button
        id="menu-close"
        type="button"
        class="grid size-12 place-items-center rounded-full text-white"
        aria-label="Close menu"
      >
        <Icon name="close" class="size-6" />
      </button>
    </div>
    <nav aria-label="Mobile" class="container-x flex-1 overflow-y-auto pb-10">
      <ul class="divide-y divide-white/10 border-y border-white/10">
        {menu.map((item, i) =>
          item.kind === "link" ? (
            <li>
              <a
                href={item.href}
                class="mobile-link block py-4 font-serif text-3xl text-white"
              >
                {item.label}
              </a>
            </li>
          ) : (
            <li data-acc>
              <button
                type="button"
                class="flex w-full items-center justify-between py-4 text-left font-serif text-3xl text-white"
                aria-expanded="false"
                aria-controls={`m-panel-${i}`}
                data-acc-trigger
              >
                {item.label}
                <span class="grid size-10 place-items-center rounded-full bg-white/10 text-ember-400">
                  <Fragment set:html={chevron} />
                </span>
              </button>
              <div id={`m-panel-${i}`} class="acc-panel" data-open="false">
                <div class="overflow-hidden">
                  {item.groups ? (
                    <div class="pt-1 pb-6">
                      {item.groups.map((g) => (
                        <details class="group/d border-b border-white/10" open={g.featured}>
                          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between text-lg text-white/90 [&::-webkit-details-marker]:hidden">
                            <span class="flex items-center gap-2">
                              {g.title}
                              {g.featured && (
                                <span class="rounded-full bg-ember-500 px-2 py-0.5 text-[0.6rem] font-bold tracking-wider text-white uppercase">
                                  Featured
                                </span>
                              )}
                            </span>
                            <span class="text-ember-400 transition-transform group-open/d:rotate-180">
                              <Fragment set:html={chevron} />
                            </span>
                          </summary>
                          <ul class="pb-3 pl-3">
                            {g.links.map((l) => (
                              <li>
                                <a
                                  href={l.href}
                                  class="mobile-link flex min-h-11 items-center text-white/75 hover:text-white"
                                >
                                  {l.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ))}
                      {item.footer && (
                        <a
                          href={item.footer.href}
                          class="mobile-link mt-3 inline-flex min-h-11 items-center gap-2 font-semibold text-ember-400"
                        >
                          {item.footer.label}{" "}
                          <Icon name="arrow" class="size-4" />
                        </a>
                      )}
                    </div>
                  ) : (
                    <ul class="pt-1 pb-5">
                      {item.links.map((l) => (
                        <li>
                          <a
                            href={l.href}
                            class="mobile-link flex min-h-12 flex-col justify-center py-1 text-white/85 hover:text-white"
                            {...ext(l.external)}
                          >
                            {l.label}
                            {l.note && (
                              <span class="text-sm text-white/50">
                                {l.note}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </li>
          ),
        )}
      </ul>
      <div class="mt-8 flex flex-col gap-3">
        <a href="/#contact" class="btn-primary mobile-link">
          Book an Appointment
        </a>
        <a href={practice.phoneHref} class="btn-ghost-light">
          Call {practice.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  @reference "../../styles/global.css";

  .nav-trigger {
    @apply hover:text-ember-400 inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 text-sm font-medium text-white/90 transition-colors;
  }
  :global(#site-header[data-solid="true"]) .nav-trigger {
    @apply text-navy-900 hover:text-ember-600;
  }
  .menu-item[data-open="true"] > .nav-trigger {
    @apply text-ember-400;
  }
  :global(#site-header[data-solid="true"])
    .menu-item[data-open="true"]
    > .nav-trigger {
    @apply bg-navy-50 text-ember-600;
  }
  .menu-item[data-open="true"] > .nav-trigger :global(.chev),
  [data-acc-trigger][aria-expanded="true"] :global(.chev) {
    transform: rotate(180deg);
  }

  /* Panels: hidden by default, fade + slide in when open */
  .menu-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.3s var(--ease-elegant),
      transform 0.45s var(--ease-elegant),
      visibility 0s linear 0.3s;
  }
  .menu-panel.drop {
    transform: translate(-50%, -8px);
  }
  .menu-item[data-open="true"] .menu-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .menu-item[data-open="true"] .menu-panel.drop {
    transform: translate(-50%, 0);
  }

  .cat-row {
    @apply text-navy-900 flex min-h-11 w-full items-center justify-between rounded-xl px-4 text-left text-[0.95rem] font-semibold transition-colors;
  }
  .cat-featured {
    @apply bg-ember-50;
  }
  .cat-row :global(svg) {
    @apply text-ember-600 -translate-x-1 opacity-0 transition duration-300;
  }
  .cat:hover > .cat-row,
  .cat:focus-within > .cat-row {
    @apply bg-ember-50 text-ember-600;
  }
  .cat:hover > .cat-row :global(svg),
  .cat:focus-within > .cat-row :global(svg) {
    @apply translate-x-0 opacity-100;
  }
  .cat-sub {
    visibility: hidden;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.25s var(--ease-elegant),
      transform 0.35s var(--ease-elegant),
      visibility 0s linear 0.25s;
  }
  .cat:hover > .cat-sub,
  .cat:focus-within > .cat-sub {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .drop-link-sm {
    @apply text-navy-900 hover:bg-ember-50 hover:text-ember-600 flex min-h-9 items-center rounded-lg px-3 text-[0.92rem] transition-colors;
  }
  .drop-link {
    @apply hover:bg-sand-50 block rounded-2xl px-4 py-3 transition-colors;
  }

  /* Mobile accordion (animates height with grid rows) */
  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-elegant);
  }
  .acc-panel[data-open="true"] {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .cat-sub,
    .acc-panel {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-menu-item]"),
  );
  let openItem: HTMLElement | null = null;
  let timer: number | undefined;

  /* ---------- Solid header when scrolled or a menu is open ---------- */
  const updateSolid = () => {
    header.dataset.solid = String(window.scrollY > 40 || openItem !== null);
  };
  updateSolid();
  window.addEventListener("scroll", updateSolid, { passive: true });

  /* ---------- Desktop menus ---------- */
  const setOpen = (item: HTMLElement | null) => {
    if (openItem === item) return;
    if (openItem) {
      openItem.dataset.open = "false";
      openItem
        .querySelector("[data-menu-trigger]")!
        .setAttribute("aria-expanded", "false");
    }
    openItem = item;
    if (item) {
      item.dataset.open = "true";
      item
        .querySelector("[data-menu-trigger]")!
        .setAttribute("aria-expanded", "true");
    }
    updateSolid();
  };

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(
      "[data-menu-trigger]",
    )!;
    const panel = item.querySelector<HTMLElement>("[data-menu-panel]")!;

    // Hover intent (mouse only): short delay so menus don't flicker
    item.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(item), openItem ? 0 : 90);
    });
    item.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(timer);
      timer = window.setTimeout(() => openItem === item && setOpen(null), 220);
    });

    // Click, tap or Enter/Space toggles
    trigger.addEventListener("click", () =>
      setOpen(openItem === item ? null : item),
    );

    // Arrow down from the trigger jumps into the panel
    trigger.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setOpen(item);
        requestAnimationFrame(() =>
          panel.querySelector<HTMLElement>("a")?.focus(),
        );
      }
    });

    // Close when keyboard focus leaves the menu
    item.addEventListener("focusout", (e) => {
      if (
        e.relatedTarget &&
        !item.contains(e.relatedTarget as Node) &&
        openItem === item
      )
        setOpen(null);
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && openItem) {
      const t = openItem.querySelector<HTMLElement>("[data-menu-trigger]");
      setOpen(null);
      t?.focus();
    }
  });
  document.addEventListener("click", (e) => {
    if (openItem && !openItem.contains(e.target as Node)) setOpen(null);
  });
  document
    .querySelectorAll("[data-menu-panel] a")
    .forEach((a) => a.addEventListener("click", () => setOpen(null)));

  /* ---------- Mobile drawer ---------- */
  const drawer = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;

  const setDrawer = (open: boolean) => {
    drawer.dataset.open = String(open);
    openBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener("click", () => setDrawer(true));
  closeBtn.addEventListener("click", () => setDrawer(false));
  drawer
    .querySelectorAll(".mobile-link")
    .forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer.dataset.open === "true") setDrawer(false);
  });

  // Accordions: one open at a time
  const accs = Array.from(drawer.querySelectorAll<HTMLElement>("[data-acc]"));
  accs.forEach((acc) => {
    const btn = acc.querySelector<HTMLButtonElement>("[data-acc-trigger]")!;
    btn.addEventListener("click", () => {
      const willOpen = btn.getAttribute("aria-expanded") !== "true";
      accs.forEach((a) => {
        a.querySelector("[data-acc-trigger]")!.setAttribute(
          "aria-expanded",
          "false",
        );
        a.querySelector<HTMLElement>(".acc-panel")!.dataset.open = "false";
      });
      if (willOpen) {
        btn.setAttribute("aria-expanded", "true");
        acc.querySelector<HTMLElement>(".acc-panel")!.dataset.open = "true";
      }
    });
  });
</script>
