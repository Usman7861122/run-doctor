---
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Gallery from "@/components/react/Gallery";
import { gallery, practice } from "@/data/site";
---

<section id="photography" class="section bg-navy-950">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <SectionHeading
        light
        eyebrow="See Dr. Maurer's Photography"
        title="Frames from the sideline and the summit."
        intro="From NFL sidelines to Pacific Northwest peaks. Click any photo to view it large."
      />
      <a
        href={practice.photographySite}
        target="_blank"
        rel="noopener"
        class="btn-ghost-light shrink-0 self-start md:self-auto"
      >
        <Icon name="camera" class="size-4" />
        Full Portfolio
      </a>
    </div>
    <div class="mt-14">
      <Gallery client:visible photos={gallery} />
    </div>
  </div>
</section>
